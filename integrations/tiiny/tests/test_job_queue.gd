extends SceneTree

const Queue = preload("res://editor/tiiny/jobs/queue.gd")
var failures := 0

func check(condition: bool, message: String) -> void:
	if not condition:
		push_error(message)
		failures += 1

func validate(operation: String, parameters: Dictionary) -> String:
	return "" if operation == "fixture" and parameters.has("value") else "unsupported request"

func append_thread(queue: RefCounted, index: int) -> Dictionary:
	return queue.append("thread-%d" % index, "fixture", {"value": index}, validate)

func _initialize() -> void:
	var root := OS.get_environment("TIINY_QUEUE_TEST_DIR")
	if root.is_empty():
		push_error("TIINY_QUEUE_TEST_DIR is required")
		quit(1)
		return
	var path := root.path_join("queue.json")
	if FileAccess.file_exists(path):
		DirAccess.remove_absolute(path)
	var queue = Queue.new()
	check(queue.open(path, "test-project"), "open")
	var contender = Queue.new()
	check(not contender.open(path, "test-project"), "exclusive lease")
	check(queue.append("bad", "other", {}, validate).has("error"), "reject invalid")
	check(queue.append("unsafe", "fixture", {"value": INF}, validate).has("error"), "reject non-JSON parameters")
	var first: Dictionary = queue.append("one", "fixture", {"value": 1}, validate)
	check(first.get("sequence") == 1, "first accepted")
	check(not queue.hide(first.id), "cannot hide an unresolved job")
	check(queue.append("one", "fixture", {"value": 1}, validate).get("duplicate") == true, "deduplicate")
	check(queue.append("one", "fixture", {"value": 2}, validate).has("error"), "key conflict")
	var second: Dictionary = queue.append("two", "fixture", {"value": 2}, validate)
	check(queue.start_next().get("id") == first.id, "FIFO start")
	check(queue.start_next().is_empty(), "single slot")
	var third: Dictionary = queue.append("three", "fixture", {"value": 3}, validate)
	check(third.sequence == 3, "append while running")
	check(queue.finish(first.id, "failed", {"error": "fixture failure"}), "failure")
	check(queue.start_next().is_empty(), "failure stops")
	check(queue.resolve(first.id, "retry"), "retry")
	check(queue.start_next().is_empty(), "resolution requires resume")
	check(queue.set_paused(false), "resume retry")
	check(queue.start_next().get("id") == first.id, "retry before later work")
	check(queue.set_paused(true), "pause")
	check(queue.finish(first.id, "completed", {}), "complete")
	check(queue.snapshot().jobs[0].attempts[0].result.error == "fixture failure", "attempt diagnostics retained")
	check(queue.snapshot().jobs[0].attempts[0].resolution.decision == "retry", "retry decision retained")
	check(queue.start_next().is_empty(), "pause prevents dispatch")
	queue.close()
	var restored = Queue.new()
	check(restored.open(path, "test-project"), "restore")
	check(restored.append("one", "fixture", {"value": 1}, validate).get("duplicate") == true, "deduplication survives JSON numeric round trip")
	check(restored.snapshot().paused, "pause persisted")
	check(restored.set_paused(false), "resume")
	check(restored.start_next().get("id") == second.id, "second in order")
	restored.close()
	var interrupted = Queue.new()
	check(interrupted.open(path, "test-project"), "interrupted restore")
	check(interrupted.snapshot().jobs[1].state == "interrupted", "unknown outcome interrupted")
	check(interrupted.start_next().is_empty(), "interruption stops")
	check(not interrupted.resolve(second.id, "retry"), "unknown outcome cannot retry")
	check(not interrupted.resolve(second.id, "skip"), "unknown outcome cannot skip")
	check(interrupted.reconcile(second.id, "failed", {"error": "no effect published"}), "reconcile")
	check(interrupted.resolve(second.id, "skip"), "explicit skip")
	check(interrupted.start_next().is_empty(), "skip requires resume")
	check(interrupted.set_paused(false), "resume after skip")
	check(interrupted.start_next().get("id") == third.id, "third after skip")
	interrupted.close()
	var corrupt := FileAccess.open(path, FileAccess.WRITE)
	corrupt.store_string("{broken")
	corrupt.close()
	var rejected = Queue.new()
	check(not rejected.open(path, "test-project"), "corruption stops")
	var concurrent_path := root.path_join("concurrent.json")
	if FileAccess.file_exists(concurrent_path):
		DirAccess.remove_absolute(concurrent_path)
	var concurrent = Queue.new()
	check(concurrent.open(concurrent_path, "test-project"), "concurrent store open")
	var threads: Array[Thread] = []
	for i in range(16):
		var thread := Thread.new()
		check(thread.start(append_thread.bind(concurrent, i)) == OK, "start append thread")
		threads.append(thread)
	var positions := {}
	for thread in threads:
		var accepted: Dictionary = thread.wait_to_finish()
		check(accepted.has("sequence"), "concurrent append accepted")
		if accepted.has("sequence"):
			positions[accepted.sequence] = true
	check(positions.size() == 16 and concurrent.snapshot().jobs.size() == 16, "concurrent positions unique")
	concurrent.close()
	var concurrent_reload = Queue.new()
	check(concurrent_reload.open(concurrent_path, "test-project"), "concurrent records persisted")
	check(concurrent_reload.snapshot().jobs.size() == 16, "all concurrent appends restored")
	concurrent_reload.close()
	var malformed := FileAccess.open(concurrent_path, FileAccess.READ)
	var document: Dictionary = JSON.parse_string(malformed.get_as_text())
	malformed.close()
	document.jobs[0].state = "completed"
	malformed = FileAccess.open(concurrent_path, FileAccess.WRITE)
	malformed.store_string(JSON.stringify(document))
	malformed.close()
	var invalid = Queue.new()
	check(not invalid.open(concurrent_path, "test-project"), "inconsistent attempts rejected")
	var journal_path := root.path_join("journal.json")
	if FileAccess.file_exists(journal_path):
		DirAccess.remove_absolute(journal_path)
	var journal = Queue.new()
	check(journal.open(journal_path, "journal-project"), "journal store open")
	var item: Dictionary = journal.append("journal", "fixture", {"value": 1}, validate)
	check(journal.start_next().id == item.id, "journal job starts")
	check(not journal.publication(item.id, "published"), "cannot publish before prepare")
	check(journal.publication(item.id, "prepared", {"source": "stage/tree.png", "destination": "tree.png", "artifact": {"sha256": "fixture"}}), "record publication intent")
	check(journal.publication(item.id, "published"), "record publication")
	check(not journal.publication(item.id, "aborted"), "cannot abort after publication")
	check(journal.finish(item.id, "failed", {"error": "import failed"}), "failure recorded")
	check(journal.snapshot().jobs[0].state == "interrupted", "published effect requires reconciliation")
	check(not journal.resolve(item.id, "retry"), "cannot retry ambiguous publication")
	check(not journal.abandon(item.id), "cannot abandon ambiguous publication")
	journal.close()
	var journal_reload = Queue.new()
	check(journal_reload.open(journal_path, "journal-project"), "journal survives restart")
	check(journal_reload.snapshot().jobs[0].attempts[0].publication.phase == "published", "publication phase persisted")
	check(journal_reload.start_next().is_empty(), "ambiguous publication stops dispatch")
	check(not journal_reload.reconcile(item.id, "failed", {}), "published effect cannot be classified as no effect")
	check(journal_reload.reconcile(item.id, "completed", {"artifact": "verified imported fixture"}), "reconcile verified import")
	check(journal_reload.snapshot().jobs[0].attempts[0].publication.phase == "imported", "reconciliation records import")
	journal_reload.close()
	var verified_reload = Queue.new()
	check(verified_reload.open(journal_path, "journal-project"), "reconciled journal survives restart")
	check(verified_reload.snapshot().paused, "reconciliation requires resume")
	verified_reload.close()
	var mutation_path := root.path_join("mutation.json")
	if FileAccess.file_exists(mutation_path):
		DirAccess.remove_absolute(mutation_path)
	var mutation_queue = Queue.new()
	check(mutation_queue.open(mutation_path, "mutation-project"), "mutation queue open")
	var mutation_job: Dictionary = mutation_queue.append("mutation", "fixture", {"value": 1}, validate)
	mutation_queue.start_next()
	check(mutation_queue.mutation(mutation_job.id, "prepared", {"scene": "res://scene.tscn"}), "record scene intent")
	check(mutation_queue.finish(mutation_job.id, "failed", {"error": "unknown effect"}), "record scene failure")
	check(mutation_queue.snapshot().jobs[0].state == "interrupted", "ambiguous scene edit stops")
	check(not mutation_queue.resolve(mutation_job.id, "retry"), "ambiguous scene edit cannot retry")
	check(not mutation_queue.abandon(mutation_job.id), "ambiguous scene edit cannot be abandoned")
	check(not mutation_queue.reconcile(mutation_job.id, "completed", {}), "scene edit needs a scene-specific verifier")
	mutation_queue.close()
	var mutation_reload = Queue.new()
	check(mutation_reload.open(mutation_path, "mutation-project"), "scene journal survives restart")
	check(mutation_reload.start_next().is_empty(), "scene journal prevents replay")
	mutation_reload.close()
	var device_path := root.path_join("device.json")
	if FileAccess.file_exists(device_path):
		DirAccess.remove_absolute(device_path)
	var device_queue = Queue.new()
	check(device_queue.open(device_path, "device-project"), "device queue open")
	var device_job: Dictionary = device_queue.append("device", "fixture", {"value": 1}, validate)
	device_queue.start_next()
	check(device_queue.device_started(device_job.id), "record device start before request")
	check(device_queue.finish(device_job.id, "failed", {"error": "timeout"}), "record device timeout")
	check(device_queue.snapshot().jobs[0].state == "interrupted", "device timeout remains uncertain")
	check(not device_queue.resolve(device_job.id, "retry") and not device_queue.reconcile(device_job.id, "failed", {}), "unknown device work cannot replay")
	check(not device_queue.resolve(device_job.id, "skip"), "unknown device work needs explicit abandon")
	check(device_queue.abandon(device_job.id), "abandon device uncertainty")
	check(device_queue.snapshot().stop_reason.is_empty() and device_queue.snapshot().paused, "abandon clears the stop and pauses")
	check(not device_queue.abandon(device_job.id), "cannot abandon twice")
	check(device_queue.start_next().is_empty(), "abandon requires resume")
	check(device_queue.hide(device_job.id), "hide resolved job")
	check(device_queue.snapshot().jobs[0].hidden == true, "hidden flag recorded")
	check(not device_queue.hide(device_job.id), "cannot hide twice")
	check(device_queue.hide_state("completed") == 0, "no completed jobs to clear")
	device_queue.close()
	var device_reload = Queue.new()
	check(device_reload.open(device_path, "device-project"), "device journal survives restart")
	check(device_reload.snapshot().jobs[0].hidden == true, "hidden flag survives restart")
	check(device_reload.start_next().is_empty(), "abandoned job is not replayed")
	device_reload.close()
	var model_path := root.path_join("model-device.json")
	if FileAccess.file_exists(model_path):
		DirAccess.remove_absolute(model_path)
	var model_queue = Queue.new()
	check(model_queue.open(model_path, "model-device-project"), "model operation queue open")
	var model_job: Dictionary = model_queue.append("model", "fixture", {"value": 1}, validate)
	model_queue.start_next()
	var identity := "a".repeat(64)
	check(not model_queue.begin_device_operation(model_job.id, "delete", "model", identity), "unsupported model operation rejected")
	check(not model_queue.begin_device_operation(model_job.id, "download", "model", "invalid"), "invalid device binding rejected")
	check(model_queue.begin_device_operation(model_job.id, "download", "model", identity), "journal before device command")
	check(not model_queue.begin_device_operation(model_job.id, "load", "model", identity), "unverified command blocks next command")
	check(not model_queue.device_operation_progress(model_job.id, INF), "nonfinite progress rejected")
	check(model_queue.device_operation_progress(model_job.id, 42.5), "device progress persisted")
	check(not model_queue.finish(model_job.id, "completed", {}), "unverified command cannot complete job")
	model_queue.close()
	var model_reload = Queue.new()
	check(model_reload.open(model_path, "model-device-project"), "reload interrupted model operation")
	var recovered: Dictionary = model_reload.snapshot().jobs[0]
	check(recovered.state == "interrupted" and recovered.attempts.back().device_started, "unknown device effect stops dispatch after restart")
	var checkpoint: Dictionary = recovered.attempts.back().device_operations.back()
	check(checkpoint.verb == "download" and checkpoint.model == "model" and checkpoint.connection == identity and checkpoint.progress == 42.5 and checkpoint.state == "started", "operation identity and progress survive restart")
	check(model_reload.start_next().is_empty() and not model_reload.resolve(model_job.id, "retry"), "unknown model operation cannot blindly replay")
	var observation := {"connection": identity, "model": "model", "verb": "download", "catalog_present": true, "installed": false, "loaded": false, "model_state": "downloading", "npu": -1.0, "checked_at": 1000}
	var wrong_observation := observation.duplicate(true)
	wrong_observation.connection = "b".repeat(64)
	check(not model_reload.observe_device_operation(model_job.id, wrong_observation), "observation from a different device is rejected")
	check(model_reload.observe_device_operation(model_job.id, observation), "record read-only device observation")
	check(model_reload.snapshot().jobs[0].state == "interrupted" and not model_reload.resolve(model_job.id, "retry"), "observation alone cannot resume uncertain work")
	model_reload.close()
	var inspected_reload = Queue.new()
	check(inspected_reload.open(model_path, "model-device-project"), "device observation survives restart")
	check(inspected_reload.snapshot().jobs[0].attempts.back().device_observation.model_state == "downloading", "device observation retained")
	inspected_reload.close()
	var verified_path := root.path_join("model-verified.json")
	if FileAccess.file_exists(verified_path):
		DirAccess.remove_absolute(verified_path)
	var verified_queue = Queue.new()
	check(verified_queue.open(verified_path, "model-verified-project"), "verified operation queue open")
	var verified_job: Dictionary = verified_queue.append("model", "fixture", {"value": 1}, validate)
	verified_queue.start_next()
	check(verified_queue.begin_device_operation(verified_job.id, "download", "model", identity), "start download checkpoint")
	check(verified_queue.verify_device_operation(verified_job.id), "record observed download")
	check(verified_queue.begin_device_operation(verified_job.id, "load", "model", identity), "start load after verified download")
	check(verified_queue.verify_device_operation(verified_job.id), "record observed load")
	check(verified_queue.finish(verified_job.id, "completed", {"model": "model"}), "verified operations complete")
	verified_queue.close()
	var model_verified_reload = Queue.new()
	check(model_verified_reload.open(verified_path, "model-verified-project"), "verified operation history survives restart")
	check(model_verified_reload.snapshot().jobs[0].attempts.back().device_operations.size() == 2, "both operations retained")
	model_verified_reload.close()
	var cancel_path := root.path_join("cancel-queued.json")
	if FileAccess.file_exists(cancel_path):
		DirAccess.remove_absolute(cancel_path)
	var cancel_queue = Queue.new()
	check(cancel_queue.open(cancel_path, "cancel-project"), "cancel queue open")
	var cancel_first: Dictionary = cancel_queue.append("cancel-one", "fixture", {"value": 1}, validate)
	var cancel_second: Dictionary = cancel_queue.append("cancel-two", "fixture", {"value": 2}, validate)
	check(cancel_queue.cancel_queued(cancel_first.id), "cancel a queued job")
	check(cancel_queue.snapshot().jobs[0].state == "cancelled" and cancel_queue.snapshot().jobs[0].attempts.is_empty(), "queued cancellation has no attempt")
	check(not cancel_queue.cancel_queued(cancel_first.id), "cannot cancel twice")
	check(cancel_queue.start_next().get("id") == cancel_second.id, "queued cancellation does not block later work")
	check(not cancel_queue.cancel_queued(cancel_second.id), "running job is not a queued cancellation")
	check(cancel_queue.finish(cancel_second.id, "completed", {}), "finish after queued cancellation")
	check(cancel_queue.hide(cancel_first.id), "hide cancelled queued job")
	var cancel_third: Dictionary = cancel_queue.append("cancel-three", "fixture", {"value": 3}, validate)
	check(cancel_queue.cancel_queued(cancel_third.id), "cancel another queued job")
	check(cancel_queue.resolve(cancel_third.id, "retry"), "retry cancelled queued job")
	check(cancel_queue.snapshot().paused, "retry requires resume")
	check(cancel_queue.set_paused(false) and cancel_queue.start_next().get("id") == cancel_third.id, "retried queued job starts")
	check(cancel_queue.finish(cancel_third.id, "completed", {}), "complete retried job")
	cancel_queue.close()
	var cancel_reload = Queue.new()
	check(cancel_reload.open(cancel_path, "cancel-project"), "cancel state survives restart")
	check(cancel_reload.snapshot().jobs[0].hidden and cancel_reload.snapshot().jobs[2].state == "completed", "cancelled queue history retained")
	cancel_reload.close()
	var confirmed_path := root.path_join("device-confirmed.json")
	if FileAccess.file_exists(confirmed_path):
		DirAccess.remove_absolute(confirmed_path)
	var confirmed_queue = Queue.new()
	check(confirmed_queue.open(confirmed_path, "device-confirmed-project"), "confirmed device queue open")
	var confirmed_job: Dictionary = confirmed_queue.append("confirmed", "fixture", {"value": 1}, validate)
	confirmed_queue.start_next()
	check(confirmed_queue.device_started(confirmed_job.id), "record device start before confirmation")
	check(confirmed_queue.confirm_device_request(confirmed_job.id), "confirm completed device request")
	check(confirmed_queue.finish(confirmed_job.id, "failed", {"error": "protocol rejection"}), "finish a confirmed failed request")
	check(confirmed_queue.snapshot().jobs[0].state == "failed", "confirmed device failure is not interrupted")
	confirmed_queue.close()
	var confirmed_reload = Queue.new()
	check(confirmed_reload.open(confirmed_path, "device-confirmed-project"), "confirmed failure survives restart")
	check(confirmed_reload.snapshot().jobs[0].attempts.back().device_confirmed == true, "device confirmation retained")
	confirmed_reload.close()
	var repeated_path := root.path_join("device-repeated.json")
	if FileAccess.file_exists(repeated_path):
		DirAccess.remove_absolute(repeated_path)
	var repeated = Queue.new()
	check(repeated.open(repeated_path, "device-repeated"), "repeated request queue open")
	var repeated_job: Dictionary = repeated.append("requests", "fixture", {"value": 1}, validate)
	repeated.start_next()
	check(repeated.device_started(repeated_job.id) and repeated.confirm_device_request(repeated_job.id), "confirm first device request")
	check(repeated.device_started(repeated_job.id), "journal second device request")
	check(not repeated.snapshot().jobs[0].attempts.back().get("device_confirmed", false), "first confirmation does not certify the second request")
	check(repeated.finish(repeated_job.id, "failed", {"error": "second request timed out"}), "record second-request failure")
	check(repeated.snapshot().jobs[0].state == "interrupted" and not repeated.resolve(repeated_job.id, "retry"), "unknown second request requires reconciliation")
	repeated.close()
	var repeated_reload = Queue.new()
	check(repeated_reload.open(repeated_path, "device-repeated"), "repeated-request state survives restart")
	check(repeated_reload.snapshot().jobs[0].state == "interrupted", "restart preserves the unknown outcome")
	repeated_reload.close()
	var model_after_path := root.path_join("device-model-after-request.json")
	if FileAccess.file_exists(model_after_path):
		DirAccess.remove_absolute(model_after_path)
	var model_after = Queue.new()
	check(model_after.open(model_after_path, "device-model-after-request"), "model-after-request queue open")
	var model_after_job: Dictionary = model_after.append("request-then-model", "fixture", {"value": 1}, validate)
	model_after.start_next()
	check(model_after.device_started(model_after_job.id) and model_after.confirm_device_request(model_after_job.id), "confirm request before model operation")
	check(model_after.begin_device_operation(model_after_job.id, "load", "image-model", "a".repeat(64)), "journal later model operation")
	check(not model_after.snapshot().jobs[0].attempts.back().get("device_confirmed", false), "prior inference confirmation does not certify a model operation")
	check(model_after.finish(model_after_job.id, "failed", {"error": "model outcome unknown"}), "record model operation failure")
	check(model_after.snapshot().jobs[0].state == "interrupted", "unverified model operation requires reconciliation")
	model_after.close()
	var handoff_path := root.path_join("handoff.json")
	if FileAccess.file_exists(handoff_path):
		DirAccess.remove_absolute(handoff_path)
	var handoff = Queue.new()
	check(handoff.open(handoff_path, "handoff-project"), "handoff queue open")
	var accept_chat := func(operation: String, parameters: Dictionary) -> String:
		return "" if operation == "chat_turn" and parameters.get("step") == 2 else "invalid continuation"
	var parent: Dictionary = handoff.append("parent", "fixture", {"value": 1}, validate)
	handoff.start_next()
	check(not handoff.finish_with_continuation(parent.id, {}, {"step": 3}, accept_chat), "invalid continuation fails closed")
	check(handoff.snapshot().jobs.size() == 1 and handoff.snapshot().jobs[0].state == "running", "invalid handoff leaves parent running and no child")
	check(handoff.finish_with_continuation(parent.id, {"response": ""}, {"step": 2}, accept_chat), "atomic handoff commits")
	var committed: Dictionary = handoff.snapshot()
	check(committed.jobs.size() == 2 and committed.jobs[0].state == "completed" and committed.jobs[0].result.next_job == committed.jobs[1].id and committed.jobs[1].state == "queued", "completed parent references exactly one queued child")
	check(not handoff.finish_with_continuation(parent.id, {}, {"step": 2}, accept_chat), "repeated handoff is rejected")
	handoff.close()
	var handoff_reload = Queue.new()
	check(handoff_reload.open(handoff_path, "handoff-project"), "completed handoff reloads")
	check(handoff_reload.snapshot().jobs.size() == 2 and handoff_reload.snapshot().jobs[0].result.next_job == handoff_reload.snapshot().jobs[1].id, "restart retains both sides of handoff")
	handoff_reload.close()
	var interrupted_path := root.path_join("handoff-interrupted.json")
	if FileAccess.file_exists(interrupted_path):
		DirAccess.remove_absolute(interrupted_path)
	var interrupted_handoff = Queue.new()
	check(interrupted_handoff.open(interrupted_path, "interrupted-handoff"), "interrupted handoff queue open")
	interrupted_handoff.append("parent", "fixture", {"value": 1}, validate)
	interrupted_handoff.start_next()
	interrupted_handoff.close()
	var interrupted_reload = Queue.new()
	check(interrupted_reload.open(interrupted_path, "interrupted-handoff"), "restart before handoff")
	check(interrupted_reload.snapshot().jobs.size() == 1 and interrupted_reload.snapshot().jobs[0].state == "interrupted" and interrupted_reload.start_next().is_empty(), "crash before handoff leaves no child and stops dispatch")
	interrupted_reload.close()
	var successor_path := root.path_join("typed-successor.json")
	if FileAccess.file_exists(successor_path):
		DirAccess.remove_absolute(successor_path)
	var typed = Queue.new()
	check(typed.open(successor_path, "typed-successor"), "typed successor queue open")
	var typed_parent: Dictionary = typed.append("typed-parent", "fixture", {"value": 1}, validate)
	var waiting: Dictionary = typed.append("waiting", "fixture", {"value": 2}, validate)
	var validate_tool := func(operation: String, parameters: Dictionary) -> String:
		return "" if operation == "tool_fixture" and parameters.get("call_id") == "call-1" else "invalid tool job"
	typed.start_next()
	check(not typed.finish_with_successor(typed_parent.id, {}, "unvalidated", {"call_id": "call-1"}, validate_tool), "successor operation must pass validation")
	check(typed.snapshot().jobs.size() == 2 and typed.snapshot().jobs[0].state == "running", "invalid successor does not complete its parent")
	check(typed.finish_with_successor(typed_parent.id, {"response": ""}, "tool_fixture", {"call_id": "call-1"}, validate_tool), "typed successor commits with parent")
	var typed_snapshot: Dictionary = typed.snapshot()
	var successor_id := str(typed_snapshot.jobs[0].result.next_job)
	check(typed_snapshot.jobs[2].id == successor_id and typed_snapshot.jobs[2].operation == "tool_fixture", "successor records its validated operation and identity")
	typed.close()
	var typed_reload = Queue.new()
	check(typed_reload.open(successor_path, "typed-successor"), "typed successor survives restart")
	check(typed_reload.start_next().get("id") == waiting.id, "previously queued work runs before successor")
	check(typed_reload.finish(waiting.id, "completed", {}), "finish earlier queued work")
	check(typed_reload.start_next().get("id") == successor_id, "typed successor runs in FIFO order")
	typed_reload.close()
	print("job queue failures: ", failures)
	quit(1 if failures else 0)
